---
/* ÇALIŞMA ALANI DETAYI
   Yeni içerik (TR): giriş paragrafları + "Bu kapsamda özellikle" listesi (Faaliyet Alanları Çalışması v-5).
   Eski içerik (EN, şimdilik): giriş + alt alanlar. */
import Temel from '../layouts/Temel.astro';
import { icerik, type Dil } from '../data/icerik';
const { dil = 'tr' as Dil, alan } = Astro.props;
const m = icerik[dil as Dil];
const tr = dil === 'tr';
const kok = (tr ? '/' : '/en/') + '#calisma-alanlari';
const yeni = Array.isArray(alan.paragraflar);
const liste = m.alanlar.liste as any[];
const sira = liste.findIndex((x) => x.slug === alan.slug);
const onceki = sira > 0 ? liste[sira - 1] : null;
const sonraki = sira < liste.length - 1 ? liste[sira + 1] : null;
const alanYolu = tr ? '/calisma-alanlari/' : '/en/practice-areas/';
---
<Temel baslik={alan.ad} aciklama={alan.ozet} dil={dil}>
  <section class="bolum bolum--kisa">
    <a class="ustBaglanti gir" href={kok}>&larr; {m.alanlar.etiket}</a>
    <h1 class="gir">{alan.ad}</h1>

    {yeni ? (
      <div class="govde">
        <div class="giris">
          {alan.paragraflar.map((p: string) => <p class="metin gir metin--giris">{p}</p>)}
        </div>
        <div class="etiket gir altBaslik">{m.alanlar.altBaslik}</div>
        <ul class="kapsam">
          {alan.kapsam.map((k: string) => <li class="gir">{k}</li>)}
        </ul>
      </div>
    ) : (
      <div>
        <p class="metin gir metin--giris">{alan.giris}</p>
        <div class="etiket gir altBaslik">{m.alanlar.altBaslik}</div>
        <div class="altlar">
          {alan.alt.map((a: any) => (
            <div class="altAlan gir">
              <h2>{a.ad}</h2>
              <p>{a.metin}</p>
            </div>
          ))}
        </div>
      </div>
    )}

    <div class="gezinti gir">
      {onceki ? <a href={alanYolu + onceki.slug + '/'}><small>&larr; {tr ? 'Önceki' : 'Previous'}</small>{onceki.ad}</a> : <span />}
      {sonraki ? <a class="sag" href={alanYolu + sonraki.slug + '/'}><small>{tr ? 'Sonraki' : 'Next'} &rarr;</small>{sonraki.ad}</a> : <span />}
    </div>

  </section>

  <!-- sabit "Görüşme talebi gönder" düğmesi: sayfa kaysa da sağda görünür kalır -->
  <a class="sabitDugme" id="sabitDugme" href={(tr ? '/' : '/en/') + '#iletisim'}>{m.iletisim.form.gonder} <span aria-hidden="true">&rarr;</span></a>
</Temel>

<script is:inline>
/* Sabit düğme alt bilgiye (footer) girmez: alt bilginin üst çizgisi ekrana girince düğme o çizginin üstünde kalacak şekilde yukarı kayar. */
(function(){
  var d = document.getElementById('sabitDugme'), alt = document.querySelector('footer');
  if (!d || !alt) return;
  var BOSLUK = 24;
  function ayarla(){
    var ust = alt.getBoundingClientRect().top;
    var tasma = Math.max(0, innerHeight - ust + BOSLUK);
    d.style.transform = tasma ? 'translateY(-' + Math.round(tasma) + 'px)' : '';
  }
  addEventListener('scroll', ayarla, { passive: true });
  addEventListener('resize', ayarla);
  ayarla();
})();
</script>

<style>
.govde{max-width:900px}
.sabitDugme{position:fixed;right:6vw;bottom:40px;z-index:60;display:inline-flex;align-items:center;gap:14px;
  padding:17px 30px;background:var(--renk-kirik-beyaz);color:var(--renk-siyah);
  font-size:12px;letter-spacing:.18em;text-transform:uppercase;white-space:nowrap;
  box-shadow:0 12px 32px rgba(0,0,0,.45);transition:gap .3s,opacity .3s}
.sabitDugme:hover{gap:22px;opacity:.9}
@media(max-width:820px){.sabitDugme{right:16px;bottom:16px;padding:14px 20px;font-size:11px}}
.giris .metin--giris{font-size:17.5px;color:var(--murekkep);max-width:62ch;margin-top:0}
.giris .metin--giris + .metin--giris{margin-top:18px}
.metin--giris{font-size:18px;color:var(--murekkep);max-width:56ch}
.altBaslik{margin-top:56px}
.kapsam{list-style:none;border-top:1px solid var(--cizgi);max-width:820px}
.kapsam li{position:relative;padding:16px 0 16px 30px;border-bottom:1px solid var(--cizgi);color:var(--soluk);line-height:1.75;font-size:15.5px}
.kapsam li::before{content:"";position:absolute;left:4px;top:28px;width:10px;height:1px;background:var(--etiket)}
.altlar{border-top:1px solid var(--cizgi);max-width:900px}
.altAlan{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.6fr);gap:32px;
padding:30px 0;border-bottom:1px solid var(--cizgi)}
.altAlan h2{font-size:clamp(20px,2vw,26px)}
.altAlan p{color:var(--soluk);line-height:1.8;font-size:15.5px}
.gezinti{display:flex;justify-content:space-between;gap:24px;max-width:900px;margin-top:56px;padding-top:28px;border-top:1px solid var(--cizgi)}
.gezinti a{display:flex;flex-direction:column;gap:6px;font-family:var(--yazi-baslik);font-size:19px;max-width:46%;transition:opacity .25s}
.gezinti a.sag{text-align:right;margin-left:auto}
.gezinti a:hover{opacity:.7}
.gezinti small{font-family:var(--yazi-govde);font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:var(--etiket)}
@media(max-width:820px){.altAlan{grid-template-columns:1fr;gap:10px}.gezinti{flex-direction:column}.gezinti a{max-width:none}.gezinti a.sag{text-align:left;margin-left:0}}
</style>
