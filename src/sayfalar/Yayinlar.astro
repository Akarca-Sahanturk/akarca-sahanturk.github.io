---
import Temel from '../layouts/Temel.astro';
import { icerik, type Dil } from '../data/icerik';
import { tarihYaz } from '../data/tarih';
import { getCollection } from 'astro:content';

const { dil = 'tr' as Dil } = Astro.props;
const m = icerik[dil as Dil];
const hepsi = (await getCollection('yayinlar', (y) => y.data.dil === dil))
  .sort((a, b) => +b.data.tarih - +a.data.tarih);
const yol = (y: any) => m.yayinlar.kok + y.id.split('/').pop() + '/';
const oneCikan = hepsi[0];
const digerleri = hepsi.slice(1);
const turAdi = (a: string) => m.yayinlar.turler.find((t) => t.anahtar === a)?.ad ?? a;
---
<Temel baslik={m.yayinlar.etiket} aciklama={m.yayinlar.baslik} dil={dil}>
  <section class="bolum bolum--kisa">
    <a class="ustBaglanti gir" href={m.kokYol + '#yayinlar'}>&larr; {m.kokYol === '/' ? 'Ana sayfa' : 'Home'}</a>
    <div class="etiket gir">{m.yayinlar.etiket}</div>
    <h1 class="gir">{m.yayinlar.baslik}</h1>

    <div class="turler gir">
      {m.yayinlar.turler.map((t) => (
        <button class="tur" data-tur={t.anahtar} type="button">
          <span class="turAd">{t.ad}</span>
          <span class="ince">{t.tanim}</span>
        </button>
      ))}
    </div>
    <button class="hepsiDugme" id="hepsiDugme" type="button" hidden>{m.yayinlar.hepsi}</button>

    {oneCikan && (
      <a class="oneCikan gir" href={yol(oneCikan)} data-tur={oneCikan.data.tur}>
        <div class="tarih">{tarihYaz(oneCikan.data.tarih, dil)} · {turAdi(oneCikan.data.tur)}</div>
        <h2>{oneCikan.data.baslik}</h2>
        <p class="ince">{oneCikan.data.ozet}</p>
      </a>
    )}

    <div class="liste gir" id="liste">
      {digerleri.map((y) => (
        <a class="kart" href={yol(y)} data-tur={y.data.tur}>
          <div class="tarih">{tarihYaz(y.data.tarih, dil)} · {turAdi(y.data.tur)}</div>
          <h3>{y.data.baslik}</h3>
          <p class="ince">{y.data.ozet}</p>
        </a>
      ))}
    </div>
    <p class="bos" id="bos" hidden>{m.yayinlar.bos}</p>
  </section>
</Temel>

<style>
.turler{display:grid;grid-template-columns:repeat(3,1fr);gap:30px;margin:44px 0 20px}
.tur{background:none;border:0;border-top:1px solid var(--cizgi-guclu);
padding:16px 0 0;margin:0;text-align:left;cursor:pointer;color:inherit;
font:inherit;text-transform:none;letter-spacing:normal;transition:border-color .35s,opacity .35s}
.tur:hover,.tur.secili{border-color:var(--murekkep);opacity:1}
.tur:not(.secili).sonuk{opacity:.45}
.turAd{display:block;font-size:13px;letter-spacing:.14em;text-transform:uppercase;
font-weight:500;margin-bottom:9px}
.hepsiDugme{background:none;border:0;padding:0;margin:4px 0 0;color:var(--etiket);
font-size:12px;letter-spacing:.14em;text-transform:uppercase;cursor:pointer;
text-decoration:underline;align-self:flex-start}
.hepsiDugme:hover{color:var(--murekkep)}

.oneCikan{display:block;transition:background .5s,color .5s,border-color .5s;border:1px solid var(--cizgi);padding:44px 40px;
margin:38px 0 26px;transition:background .45s,border-color .45s}
.oneCikan:hover{background:#fff;border-color:var(--cizgi-guclu);color:var(--renk-siyah)}
.oneCikan h2{font-size:clamp(24px,2.8vw,36px);margin:14px 0 14px;max-width:24ch}
.oneCikan p{max-width:60ch}

.liste{display:grid;grid-template-columns:1fr 1fr;gap:1px;
background:var(--cizgi);border:1px solid var(--cizgi)}
.kart{background:var(--zemin);padding:32px 28px 36px;min-height:200px;
transition:background .4s}
.kart:hover{background:#fff;color:var(--renk-siyah)}
.kart h3{font-size:21px;margin:14px 0 12px;line-height:1.4}
.tarih{font-size:11px;letter-spacing:.16em;color:var(--etiket)}
.gizli{display:none!important}
.bos{margin-top:34px;color:var(--etiket);font-size:15px}
@media(max-width:820px){.turler,.liste{grid-template-columns:1fr}.oneCikan{padding:32px 26px}}
</style>

<script is:inline>
(function(){
  var dugmeler = [].slice.call(document.querySelectorAll('.tur'));
  var kartlar = [].slice.call(document.querySelectorAll('[data-tur]'));
  var hepsiDugme = document.getElementById('hepsiDugme');
  var bos = document.getElementById('bos');
  var secili = null;

  function uygula(){
    var gorunen = 0;
    kartlar.forEach(function(k){
      if(k.classList.contains('tur')) return;
      var uydu = !secili || k.getAttribute('data-tur') === secili;
      k.classList.toggle('gizli', !uydu);
      if(uydu) gorunen++;
    });
    dugmeler.forEach(function(d){
      d.classList.toggle('secili', d.getAttribute('data-tur') === secili);
      d.classList.toggle('sonuk', !!secili);
    });
    hepsiDugme.hidden = !secili;
    bos.hidden = gorunen > 0;
  }

  dugmeler.forEach(function(d){
    d.addEventListener('click', function(){
      var t = d.getAttribute('data-tur');
      secili = (secili === t) ? null : t;
      uygula();
    });
  });
  hepsiDugme.addEventListener('click', function(){ secili = null; uygula(); });
})();
</script>
