---
import AlanDetay from '../../sayfalar/AlanDetay.astro';
import { icerik } from '../../data/icerik';

export async function getStaticPaths() {
  // Aynı sıradaki İngilizce sayfa, hreflang için
  return icerik.tr.alanlar.liste.map((a, i) => ({
    params: { slug: a.slug },
    props: { alan: a, alternatif: '/en/practice-areas/' + icerik.en.alanlar.liste[i].slug + '/' },
  }));
}
const { alan, alternatif } = Astro.props;
---
<AlanDetay dil="tr" alan={alan} alternatif={alternatif} />
