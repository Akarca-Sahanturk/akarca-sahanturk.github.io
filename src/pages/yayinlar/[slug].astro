---
import YayinDetay from '../../sayfalar/YayinDetay.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const hepsi = await getCollection('yayinlar', (y) => y.data.dil === 'tr');
  return hepsi.map((y) => ({
    params: { slug: y.id.split('/').pop() },
    props: { yayin: y },
  }));
}
const { yayin } = Astro.props;
const { Content } = await render(yayin);
---
<YayinDetay dil="tr" yayin={yayin} Icerik={Content} />
