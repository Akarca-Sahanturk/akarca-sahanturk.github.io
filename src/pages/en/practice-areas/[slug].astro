---
import AlanDetay from '../../../sayfalar/AlanDetay.astro';
import { icerik } from '../../../data/icerik';

export async function getStaticPaths() {
  // Aynı sıradaki Türkçe sayfa, hreflang için
  return icerik.en.alanlar.liste.map((a, i) => ({
    params: { slug: a.slug },
    props: { alan: a, alternatif: '/calisma-alanlari/' + icerik.tr.alanlar.liste[i].slug + '/' },
  }));
}
const { alan, alternatif } = Astro.props;
---
<AlanDetay dil="en" alan={alan} alternatif={alternatif} />
