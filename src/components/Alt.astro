---
import { icerik, buro, type Dil } from '../data/icerik';
const { dil = 'tr' as Dil } = Astro.props;
const m = icerik[dil as Dil];
---
<footer class="altbilgi">
  <div>{m.altbilgi.haklar}</div>
  <nav>
    {m.altbilgi.baglantilar.map((x) => <a href={x.yol}>{x.ad}</a>)}
    <a href={buro.linkedin} target="_blank" rel="noopener">{m.altbilgi.linkedin}</a>
  </nav>
</footer>

<div class="cerez" id="cerez" hidden>
  <p>{m.cerezUyari.metin}</p>
  <div class="cerezDugmeler">
    <a href={m.altbilgi.baglantilar[2].yol}>{m.cerezUyari.detay}</a>
    <button id="cerezKabul">{m.cerezUyari.kabul}</button>
  </div>
</div>

<style>
.altbilgi{background:var(--renk-siyah);color:#a3a09b;padding:48px 6vw;border-top:1px solid rgba(252,249,243,.1);
display:flex;justify-content:space-between;flex-wrap:wrap;gap:18px;
font-size:12.5px}
.altbilgi nav{display:flex;gap:26px;flex-wrap:wrap}
.altbilgi a{transition:color .25s}
.altbilgi a:hover{color:var(--renk-kirik-beyaz)}
@media(max-width:820px){.altbilgi{padding:40px 24px}}

.cerez{position:fixed;left:24px;bottom:24px;z-index:95;max-width:400px;
background:rgba(19,19,19,.97);border:1px solid rgba(252,249,243,.16);
padding:22px 24px;font-size:13.5px;color:#dad7d1;line-height:1.7}
.cerezDugmeler{display:flex;align-items:center;gap:20px;margin-top:16px}
.cerezDugmeler a{font-size:12px;letter-spacing:.1em;text-decoration:underline;opacity:.7}
.cerez button{margin:0;padding:11px 22px;font-size:11px}
@media(max-width:600px){.cerez{left:16px;right:16px;bottom:16px;max-width:none}}
</style>

<script is:inline>
(function(){
  var k = document.getElementById('cerez'), d = document.getElementById('cerezKabul');
  if(!k || !d) return;
  var kabul = false;
  try { kabul = localStorage.getItem('cerez') === '1'; } catch(e){}
  if(!kabul) setTimeout(function(){ k.hidden = false; }, 3400);
  d.addEventListener('click', function(){
    k.hidden = true;
    try { localStorage.setItem('cerez','1'); } catch(e){}
  });
})();
</script>
