---
import '../styles/tokens.css';
import '../styles/yazi.css';
import '../styles/global.css';
import Ust from '../components/Ust.astro';
import Alt from '../components/Alt.astro';
import Acilis from '../components/Acilis.astro';
import { buro, type Dil } from '../data/icerik';

interface Props {
  baslik: string;
  aciklama?: string;
  dil?: Dil;
  acilis?: boolean;
  tema?: 'koyu' | 'acik';
  alternatif?: string;   /* diğer dildeki karşılık sayfanın yolu (hreflang) */
}
const { baslik, aciklama = '', dil = 'tr', acilis = false, tema = 'koyu', alternatif } = Astro.props;
const tamBaslik = baslik === 'Akarca Sahanturk' ? baslik : baslik + ' — Akarca Sahanturk';

/* Site adresi: astro.config'teki `site` (şimdilik GitHub Pages). Alan adı bağlanınca yalnızca orası değişir. */
const kok = (Astro.site ?? new URL(buro.alanAdi)).href.replace(/\/$/, '');
const yol = Astro.url.pathname;
const tamAdres = kok + yol;

/* Dil karşılıkları (hreflang): sabit sayfalar + ekip sayfaları. Bire bir karşılığı olmayan sayfalar yalnızca kendini bildirir. */
const esler: Record<string, string> = { '/': '/en/', '/yayinlar/': '/en/publications/', '/kvkk/': '/en/privacy/',
  '/cerez-politikasi/': '/en/cookie-policy/', '/basvuru/': '/en/apply/' };
const tersEsler: Record<string, string> = Object.fromEntries(Object.entries(esler).map(([a, b]) => [b, a]));
let digerDilYolu: string | undefined = alternatif;
if (!digerDilYolu) {
  if (esler[yol]) digerDilYolu = esler[yol];
  else if (tersEsler[yol]) digerDilYolu = tersEsler[yol];
  else if (yol.startsWith('/ekip/')) digerDilYolu = yol.replace('/ekip/', '/en/team/');
  else if (yol.startsWith('/en/team/')) digerDilYolu = yol.replace('/en/team/', '/ekip/');
}
const trYolu = dil === 'tr' ? yol : digerDilYolu;
const enYolu = dil === 'en' ? yol : digerDilYolu;

/* Yapılandırılmış veri: Google'ın büroyu tanıması için */
const yapisalVeri = {
  '@context': 'https://schema.org', '@type': 'LegalService',
  name: buro.ad, url: kok + '/', image: kok + '/marka/paylasim.jpg', logo: kok + '/marka/isaret.svg',
  telephone: buro.telefon, email: buro.eposta,
  address: { '@type': 'PostalAddress', streetAddress: buro.adresSatirlari[0], postalCode: '34394', addressLocality: 'Şişli', addressRegion: 'İstanbul', addressCountry: 'TR' },
  areaServed: 'TR', priceRange: '$$$', sameAs: [buro.linkedin],
  founder: [{ '@type': 'Person', name: 'Hüseyin Eren Akarca' }, { '@type': 'Person', name: 'Atahan Şahantürk' }],
  knowsAbout: ['Vergi hukuku', 'Gümrük hukuku', 'Şirketler hukuku', 'Birleşme ve devralmalar', 'Uyuşmazlık çözümü'],
};
---
<!doctype html>
<html lang={dil}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{tamBaslik}</title>
  {aciklama && <meta name="description" content={aciklama} />}
  <link rel="icon" href="/marka/isaret.svg" type="image/svg+xml" />
  {!buro.aramaMotorlarinaAcik && <meta name="robots" content="noindex, nofollow" />}
  <link rel="canonical" href={tamAdres} />
  {trYolu && <link rel="alternate" hreflang="tr" href={kok + trYolu} />}
  {enYolu && <link rel="alternate" hreflang="en" href={kok + enYolu} />}
  {trYolu && <link rel="alternate" hreflang="x-default" href={kok + trYolu} />}
  <meta property="og:site_name" content="Akarca Sahanturk" />
  <meta property="og:title" content={tamBaslik} />
  <meta property="og:description" content={aciklama} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={tamAdres} />
  <meta property="og:image" content={kok + '/marka/paylasim.jpg'} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale" content={dil === 'tr' ? 'tr_TR' : 'en_US'} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={tamBaslik} />
  <meta name="twitter:description" content={aciklama} />
  <meta name="twitter:image" content={kok + '/marka/paylasim.jpg'} />
  <link rel="preload" href="/yazi/libre-baskerville-400-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/yazi/libre-baskerville-400-latin-ext.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/yazi/dm-sans-400-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/yazi/dm-sans-400-latin-ext.woff2" as="font" type="font/woff2" crossorigin />
  <script type="application/ld+json" set:html={JSON.stringify(yapisalVeri)} />
</head>
<body class={tema === 'acik' ? 'acik' : ''}>
  {acilis && <Acilis />}
  <Ust dil={dil} />
  <!-- film greni: düz dijital siyahı kırar; %3 civarı görünürlük, hareketsiz -->
  <div class="gren" aria-hidden="true"></div>
  <main>
    <slot />
  </main>
  <Alt dil={dil} />

  <script is:inline>
    (function(){
      /* Bölüm ekrana girince içindeki .gir parçaları sırayla belirir;
         bölüm ekrandan tamamen çıkınca sıfırlanır ki geri gelince yeniden oynasın. */
      var bolumler = [].slice.call(document.querySelectorAll('section'));
      var go = new IntersectionObserver(function(kayitlar){
        kayitlar.forEach(function(k){
          var parcalar = k.target.querySelectorAll('.gir');
          if (k.isIntersecting && k.intersectionRatio >= 0.12) {
            parcalar.forEach(function(g, i){
              g.style.transitionDelay = (i * 60) + 'ms';
              g.classList.add('gorundu');
            });
          } else if (!k.isIntersecting) {
            parcalar.forEach(function(g){
              g.style.transitionDelay = '0ms';
              g.classList.remove('gorundu');
            });
          }
        });
      }, { threshold: [0, 0.12] });
      function basla(){ bolumler.forEach(function(b){ go.observe(b); }); }
      /* açılış animasyonu varsa, içerik logo yerleşirken belirsin */
      if (document.getElementById('acilis')) {
        var basladi = false;
        var bir = function(){ if (!basladi) { basladi = true; basla(); } };
        document.addEventListener('acilis:bitti', bir, { once: true });
        setTimeout(bir, 5000);
      } else basla();
    })();
  </script>
</body>
</html>
